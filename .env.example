# Server
PORT=3000

# Web dev server / proxy target
WEB_PORT=5173
PROXUS_API_URL=http://localhost:3000

# Google Gemini
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here
# Tiene que ser un modelo que Google sirva hoy a tu clave. Google retira modelos
# y deja de servirlos a claves nuevas, así que un valor caducado aquí hace que la
# primera llamada devuelva 404. Si eso pasa, el error dice el estado y el modelo.
GEMINI_MODEL=gemini-3.5-flash-lite
